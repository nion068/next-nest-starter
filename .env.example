NODE_ENV=development
WEB_PORT=3000
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://app:app@localhost:5432/app?schema=public
# PostgreSQL schema used internally by pg-boss. It is created automatically.
PG_BOSS_SCHEMA=pgboss
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@example.test
SMS_PROVIDER=console

# Optional OpenTelemetry endpoint. The local SigNoz setup listens here.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=starter-api
